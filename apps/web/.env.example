# ===========================================
# Portfolio X-Ray Web - Environment Variables
# ===========================================
# Copy this file to .env.local and update the values

# API Configuration
# The URL of the backend API server
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site origin used for canonical URLs, hreflang, sitemap, and robots.
# No trailing slash. Production must be the www host.
NEXT_PUBLIC_SITE_URL=https://www.xrayportfolio.com
